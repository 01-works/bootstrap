+/** Summarize known errors without exposing Google's account verification URL. */
+export function antigravityUsageError(output: string): string {
+  try {
+    const result = JSON.parse(output) as { error?: unknown } | null;
+    if (typeof result?.error === "string" && result.error.includes("Eligibility check failed:") &&
+        result.error.includes("Verify your account to continue.")) {
+      return "Google requires account verification. Run /usage in agy with this account and follow Google's verification link.";
+    }
+  } catch {
+    // agy can fail before returning JSON.
+  }
+  return "Antigravity did not report usage. Check /usage inside agy.";
+}
