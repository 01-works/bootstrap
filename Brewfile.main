# 메인 개발기 추가분 (profiles/main.sh)

tap "steipete/tap"

# Node: 개발은 fnm으로 (development/node.md). brew "node"는 Hermes 대시보드가 쓴다
brew "fnm"
brew "node"

# 컨테이너 (development/containers.md)
brew "colima", restart_service: :changed
brew "docker"
brew "docker-buildx"
brew "docker-compose"

# 에이전트 (agents/README.md). Claude Code는 scripts/steps/60-agents.sh에서 설치
cask "codex"
cask "paseo"
cask "claude"
cask "chatgpt"  # Codex 설정이 이 앱 안의 파일을 참조한다
cask "steipete/tap/codexbar", trusted: true

# 에이전트가 쓰는 도구
brew "ffmpeg"   # Hermes 음성 변환
brew "ripgrep"  # 에이전트가 셸에서 검색할 때

# 터널
brew "cloudflared"
